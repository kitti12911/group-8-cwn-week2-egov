<%- include('partials/head') %>
<h1>Dashboard ผู้บริหาร</h1>
<p class="muted">ตัวเลขรวมเท่านั้น ไม่มีข้อมูลส่วนบุคคล · งานคงค้างและเกินกำหนดคงค้างเป็นค่า ณ ตอนนี้ (ไม่ขึ้นกับช่วงที่เลือก)</p>

<form id="dash-filter" class="card grid" method="get" action="/dashboard">
  <label>เดือน/ปี
    <select name="period" data-testid="period-select">
      <% periods.forEach(function (p) { %><option value="<%= p.value %>"<%= p.value === k.period ? ' selected' : '' %>><%= p.label %></option><% }); %>
    </select>
  </label>
  <label>บริการ
    <select name="service" data-testid="service-select">
      <option value="ALL"<%= k.service === 'ALL' ? ' selected' : '' %>>ทั้งหมด</option>
      <% services.forEach(function (s) { %><option value="<%= s %>"<%= k.service === s ? ' selected' : '' %>><%= s %></option><% }); %>
    </select>
  </label>
  <noscript><button type="submit">แสดง</button></noscript>
</form>

<section class="grid" aria-label="ตัวชี้วัด" aria-live="polite">
  <% var ids = ['kpi-received', 'kpi-closed', 'kpi-ontime-pct', 'kpi-backlog', 'kpi-overdue']; %>
  <% ids.forEach(function (id, i) { %>
  <div class="card">
    <div class="muted"><%= labels5[i] %></div>
    <div class="kpi" data-testid="<%= id %>"><%= values[i] %></div>
  </div>
  <% }); %>
</section>

<h2>งานในมือรายเจ้าหน้าที่ (กำลังตรวจสอบ)</h2>
<div class="table-wrap">
  <table>
    <thead><tr><th>เจ้าหน้าที่</th><th>งานในมือ</th></tr></thead>
    <tbody id="workload-body">
      <% k.workload.forEach(function (w) { %>
      <tr data-testid="workload-row" data-username="<%= w.username %>"><td><%= w.username %></td><td data-testid="workload-value"><%= w.count %></td></tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="actions">
  <a class="btn" id="export-xlsx" data-testid="export-xlsx-btn" download
     href="/api/dashboard/export?format=xlsx&period=<%= encodeURIComponent(k.period) %>&service=<%= encodeURIComponent(k.service) %>">ส่งออก Excel</a>
  <a class="btn secondary" id="export-pdf" data-testid="export-pdf-btn" download
     href="/api/dashboard/export?format=pdf&period=<%= encodeURIComponent(k.period) %>&service=<%= encodeURIComponent(k.service) %>">ส่งออก PDF</a>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var form = document.getElementById('dash-filter');
  var period = form.elements.period, service = form.elements.service;
  var seq = 0;
  function pctText(p) { return p === null ? '–' : p.toFixed(1) + '%'; }
  function setText(id, v) { var el = document.querySelector('[data-testid="' + id + '"]'); if (el) el.textContent = v; }
  function qs(format) {
    var p = new URLSearchParams();
    if (format) p.set('format', format);
    p.set('period', period.value); p.set('service', service.value);
    return p.toString();
  }
  // export: fetch the file (so errors can be shown) then hand the bytes to the browser as a download
  ['export-xlsx', 'export-pdf'].forEach(function (id) {
    var a = document.getElementById(id);
    a.addEventListener('click', function (ev) {
      ev.preventDefault();
      fetch(a.href, { credentials: 'same-origin' }).then(function (r) {
        if (!r.ok) return r.json().then(function (j) { egov.showError((j && j.message) || 'เกิดข้อผิดพลาด', 'action-error'); });
        var cd = r.headers.get('Content-Disposition') || '';
        var m = /filename="?([^";]+)"?/.exec(cd);
        var name = m ? m[1] : (id === 'export-pdf' ? 'dashboard.pdf' : 'dashboard.xlsx');
        return r.blob().then(function (blob) {
          var url = URL.createObjectURL(blob);
          var tmp = document.createElement('a');
          tmp.href = url; tmp.download = name; tmp.style.display = 'none';
          document.body.appendChild(tmp); tmp.click(); tmp.remove();
          setTimeout(function () { URL.revokeObjectURL(url); }, 10000);
        });
      }).catch(function () { egov.showError('เกิดข้อผิดพลาด', 'action-error'); });
    });
  });
  function refresh() {
    var mine = ++seq;
    document.getElementById('export-xlsx').href = '/api/dashboard/export?' + qs('xlsx');
    document.getElementById('export-pdf').href = '/api/dashboard/export?' + qs('pdf');
    history.replaceState(null, '', '/dashboard?' + qs());
    egov.api('GET', '/api/dashboard?' + qs()).then(function (r) {
      if (mine !== seq) return; // a newer selection is in flight
      if (!r.ok) { egov.showError((r.data && r.data.message) || 'เกิดข้อผิดพลาด', 'action-error'); return; }
      var d = r.data;
      setText('kpi-received', d.received); setText('kpi-closed', d.closed);
      setText('kpi-ontime-pct', pctText(d.ontimePct));
      setText('kpi-backlog', d.backlog); setText('kpi-overdue', d.overdue);
      var body = document.getElementById('workload-body');
      body.innerHTML = '';
      d.workload.forEach(function (w) {
        var tr = document.createElement('tr');
        tr.setAttribute('data-testid', 'workload-row'); tr.setAttribute('data-username', w.username);
        var a = document.createElement('td'); a.textContent = w.username;
        var b = document.createElement('td'); b.setAttribute('data-testid', 'workload-value'); b.textContent = w.count;
        tr.appendChild(a); tr.appendChild(b); body.appendChild(tr);
      });
    });
  }
  period.addEventListener('change', refresh);
  service.addEventListener('change', refresh);
});
</script>
<%- include('partials/foot') %>
